{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@assets/*": ["./assets/*"],
      "@client/*": ["./client/*"],
      "@core/*": ["./core/*"]
    },
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true,
  },
  "exclude": ["node_modules", "public"],
  "include": ["**/*.ts" ]
}
